# ==============================================================================
# KONFIGURASI REMOTE CONSOLE & OTA MANAGER ESP32 (PT BEKAERT INDONESIA)
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ==============================================================================

# Port Web Server (default 3000)
PORT=3000

# Akun Login Admin Dashboard Web
ADMIN_USER=admin
ADMIN_PASSWORD=ganti_dengan_password_admin_min_10_karakter

# Kunci API Rahasia Perangkat ESP32 (Wajib minimal 16 karakter)
# HARUS SAMA PERSIS dengan konstanta REMOTE_API_KEY di sketch ESP32
DEVICE_API_KEY=bekaert_esp32_device_key_2026

# Konfigurasi Opsional:
# BASE_PATH=/
# DATA_DIR=./data
# FAST_MS=5000     # Polling interval saat admin sedang menonton serial monitor
# SLOW_MS=30000    # Polling interval saat idle (menghemat kuota/baterai)
